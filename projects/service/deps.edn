{:deps {org.clojure/clojure {:mvn/version "1.12.4"}

        aero/aero                                         {:mvn/version "1.1.6"}
        org.clojure/tools.logging                         {:mvn/version "1.3.1"}
        com.stuartsierra/component                        {:mvn/version "1.2.0"}
        ch.qos.logback/logback-classic                    {:mvn/version "1.5.6"}
        net.logstash.logback/logstash-logback-encoder     {:mvn/version "7.4"}

        poly/persistence           {:local/root "../../components/persistence"}
        poly/server                {:local/root "../../components/server"}
        poly/service               {:local/root "../../bases/service"}}

 :aliases {:build   {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.12"}
                                  org.clojure/tools.deps        {:mvn/version "0.28.1578"}}
                     :paths      ["build/resources"]
                     :ns-default build}
           :test    {:extra-paths ["../../components/persistence/spec"
                                   "../../components/server/spec"
                                   "../../bases/service/spec"]
                     :extra-deps  {speclj/speclj {:mvn/version "3.12.0"}
                                   etaoin/etaoin  {:mvn/version "1.1.43"}}}
           :uberjar {:main com.pringwa.service.main}}}
