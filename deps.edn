{:aliases  {:build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.12"}
                           org.clojure/tools.deps        {:mvn/version "0.28.1569"}}
                    :paths ["build/resources"]
                    :ns-default build}
            :dev   {:extra-paths ["development/src"]

                    :extra-deps  {poly/persistence           {:local/root "components/persistence"}
                                  poly/server                {:local/root "components/server"}

                                  poly/service               {:local/root "bases/service"}

                                  org.clojure/clojure        {:mvn/version "1.12.4"}
                                  org.clojure/tools.logging  {:mvn/version "1.3.1"}

                                  com.stuartsierra/component {:mvn/version "1.2.0"}}}

            :outdated {:main-opts  ["-m" "antq.core"]
                       :extra-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}}

            :test {:main-opts ["-m" "speclj.main" "-c"]
                   :extra-paths ["test" "spec"  "bases/service/spec" "bases/service/test"]
                   :extra-deps  {speclj/speclj {:mvn/version "3.13.0"}}}

            :poly {:main-opts  ["-m" "polylith.clj.core.poly-cli.core"]
                   :jvm-opts   ["--enable-native-access=ALL-UNNAMED"]
                   :extra-deps {polylith/clj-poly {:mvn/version "0.3.32"}}}

            :cljfmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.0"}}
                     :main-opts ["-m" "cljfmt.main"]}}}
