{:aliases  {:dev   {:extra-paths ["development/src"]

                    :extra-deps  {poly/app-state             {:local/root "components/app_state"}
                                  poly/persistence           {:local/root "components/persistence"}
                                  poly/server                {:local/root "components/server"}

                                  poly/service               {:local/root "bases/service"}

                                  org.clojure/clojure        {:mvn/version "1.12.4"}}

                                  com.stuartsierra/component {:mvn/version "1.2.0"}}

            :outdated {:main-opts  ["-m" "antq.core"]
                       :extra-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}}

            :test {:extra-paths []}

            :poly {:main-opts  ["-m" "polylith.clj.core.poly-cli.core"]
                   :jvm-opts   ["--enable-native-access=ALL-UNNAMED"]
                   :extra-deps {polylith/clj-poly {:mvn/version "0.3.32"}}}}}
