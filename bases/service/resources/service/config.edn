{:data {:filename   "persistence/indicators.json"
        :batch-size #profile {:dev 3 :default 100}}

 :database #profile
           {:dev     {:client  {:server-type :datomic-local
                                :storage-dir :mem
                                :system      "indicators"}
                      :db-name "indicators"}
            :staging {:client  {:server-type :cloud
                                :region      #or [#env DATOMIC_REGION "us-east-1"]
                                :system      #or [#env DATOMIC_SYSTEM "indicators-staging"]
                                :endpoint    #env DATOMIC_ENDPOINT}
                      :db-name #or [#env DATOMIC_DB_NAME "indicators-staging"]}
            :prod    {:client  {:server-type :cloud
                                :region      #or [#env DATOMIC_REGION "us-east-1"]
                                :system      #or [#env DATOMIC_SYSTEM "indicators-prod"]
                                :endpoint    #env DATOMIC_ENDPOINT}
                      :db-name #or [#env DATOMIC_DB_NAME "indicators-prod"]}}

 :server {:host             #or [#env HOST "localhost"]
          :port             #long #or [#env PORT 8080]
          :stop-timeout-ms  #long #or [#env STOP_TIMEOUT_MS 10000]}

 ;; Authentication options passed to wrap-authentication.
 ;; :dev? true  — skip JWT validation, inject a dev identity (local only)
 ;; :validator-fn — supply at runtime (Cognito/Auth0 JWKS validator, etc.)
 ;;                 For Ion deployments leave nil; API Gateway validates tokens.
 :auth #profile {:dev     {:dev? true}
                 :staging {}
                 :prod    {}}

 :cors #profile {:dev     {:allowed-origins ["*"]}
                 :staging {:allowed-origins [#or [#env CORS_ORIGIN "https://staging.example.com"]]}
                 :prod    {:allowed-origins [#or [#env CORS_ORIGIN "https://app.example.com"]]}}

 :rate-limit #profile {:dev     {:requests-per-second 1000}
                       :default {:requests-per-second 100}}

 :timeout {:timeout-ms #long #or [#env REQUEST_TIMEOUT_MS 30000]}

 :circuit-breaker {:failure-threshold   #long #or [#env CB_FAILURE_THRESHOLD 5]
                   :recovery-timeout-ms #long #or [#env CB_RECOVERY_TIMEOUT_MS 30000]
                   :success-threshold   #long #or [#env CB_SUCCESS_THRESHOLD 2]}}
